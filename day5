  #include <stdio.h>

int main() {
    int originalNum, num, rem, sum = 0;
    long fact;
    printf("Enter an integer: ");
    scanf("%d", &originalNum);
    num = originalNum;
    while (num > 0) {
        rem = num % 10;  
        fact = 1;
        for (int i = 1; i <= rem; i++) {
            fact *= i;
        }
        sum += fact;
        num /= 10;       
    }

    if (sum == originalNum) {
        printf("%d is a Strong Number.\n", originalNum);
    } else {
        printf("%d is NOT a Strong Number.\n", originalNum);
    }

    return 0;
}

