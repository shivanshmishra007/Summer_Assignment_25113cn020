int isArmstrong(int num) {
    int originalNum, remainder, digits = 0, sum = 0;

    originalNum = num;

  
    while (originalNum != 0) {
        originalNum /= 10;
        digits++;
    }

    originalNum = num;
    while (originalNum != 0) {
        remainder = originalNum % 10;
        sum += round(pow(remainder, digits));
        
        originalNum /= 10;
    }

    return (sum == num);
}

