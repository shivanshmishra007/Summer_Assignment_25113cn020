  scanf("%d",&n);
  int x=n;
  while(n>0)
  {
      a=n%10;
      rev=rev*10+a;
      n=n/10;
  }
  if(rev==x)
  printf("Palindrome number");
  else
  printf("Not palindrome ");
  return 0;
 }
  
