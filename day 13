    #include <stdio.h>
    int main() {
    int size, i;
    int sum = 0;
    float average;
    printf("Enter the number of elements: ");
    scanf("%d", &size);

    int arr[size];
    printf("Enter %d elements:\n", size);
    for (i = 0; i < size; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < size; i++) {
        sum += arr[i];
    }

    average = (float)sum / size;

    printf("Results");
    printf("Sum of array elements = %d\n", sum);
    printf("Average of array elements = %.2f\n", average);

    return 0;
}

