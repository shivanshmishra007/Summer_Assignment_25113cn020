  #include <stdio.h>

int main() {
    int size, i;
    int evenCount = 0;
    int oddCount = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &size);

    int arr[size];
    printf("Enter %d elements:\n", size);
    for (i = 0; i < size; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }
    for (i = 0; i < size; i++) {
        if (arr[i] % 2 == 0) {
            evenCount++;
        } else {
            oddCount++;   
        }
    }
    printf("Results");
    printf("Total Even elements = %d\n", evenCount);
    printf("Total Odd elements = %d\n", oddCount);

    return 0;
}
