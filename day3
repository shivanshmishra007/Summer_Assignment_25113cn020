    printf("Enter num2: ");
    scanf("%d", &num2);      


    int limit = (num1 < num2) ? num1 : num2;

    
    while(a <= limit) 
    {
        if(num1 % a == 0 && num2 % a == 0) {
            gcd = a; 
        }
